{
  "version": "0.2.1",
  "tasks": [
    {
      "taskLabel": "Launch",
      "appliesTo": "/",
      "type": "launch",
      "command": ".\\venv\\Scripts\\python.exe",
      "args": [ "gradio_app.py" ]
    },
    {
      "taskLabel": "Install venv",
      "appliesTo": "/",
      "type": "launch",
      "command": "${env.COMSPEC}",
      "args": [ "python -m venv venv && .\\venv\\Scripts\\pip.exe install -r requirements.txt" ]
    }
  ]
}